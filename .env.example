# Скопируй в .env и заполни. .env не коммитим.

# Postgres
POSTGRES_DB=chords
POSTGRES_USER=chords
POSTGRES_PASSWORD=change-me
# Порт Postgres на хосте (127.0.0.1) — для бэкенда в дев-режиме
POSTGRES_PORT=5434

# Порт приложения на хосте
APP_PORT=8080

# Первый администратор: создаётся при старте, только если таблица app_user пуста
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-too

# true, если сайт открыт по HTTPS (cookie сессии только по HTTPS)
COOKIE_SECURE=false
